  "author": "",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@wordpress/scripts": "^30.19.0",
    "@vitejs/plugin-react": "^5.2.0",
    "husky": "^9.1.7",
    "path": "^0.12.7",
    "rollup-plugin-external-globals": "^0.13.0",
    "sass": "^1.93.2",
    "vite": "^7.3.7",
    "vite-plugin-external": "^6.2.2",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "lint-staged": "^16.1.2",
    "npm-run-all": "^4.1.5"
  }
